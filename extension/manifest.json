{
  "manifest_version": 3,
  "name": "Heir Search - Multi-Source",
  "version": "1.1.0",
  "description": "Search FamilySearch and MyHeritage with Hebrew names - generates English variants automatically",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],

  "host_permissions": [
    "https://www.familysearch.org/*",
    "https://www.myheritage.com/*",
    "https://www.myheritage.co.il/*",
    "http://localhost/*"
  ],

  "action": {
    "default_title": "Heir Search - Multi-Source"
  },

  "side_panel": {
    "default_path": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.familysearch.org/*"],
      "js": ["content/familysearch.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.myheritage.com/*", "https://www.myheritage.co.il/*"],
      "js": ["content/myheritage.js"],
      "run_at": "document_idle"
    }
  ]
}
